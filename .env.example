APP_NAME="Lokabuy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://lokabuy.test

LOG_CHANNEL=daily
LOG_LEVEL=debug

# ------------------------------------------------------------
# Database — MySQL via Laragon
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lokabuy
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------
# Cache & Queue — Redis
# ------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------
# Mail — configure your transactional provider (SendGrid / SES)
# ------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@lokabuy.com
MAIL_FROM_NAME="Lokabuy"

# ------------------------------------------------------------
# File Storage — local public disk (switch to s3 for production)
# ------------------------------------------------------------
FILESYSTEM_DRIVER=public

# ------------------------------------------------------------
# Sanctum — add your frontend domain(s), comma-separated
# ------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,lokabuy.test

# ------------------------------------------------------------
# CORS — frontend origins allowed to call the API
# ------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost,http://lokabuy.test

# ------------------------------------------------------------
# Admin seed user — used by AdminUserSeeder only
# ------------------------------------------------------------
ADMIN_EMAIL=admin@lokabuy.com
ADMIN_PASSWORD=secret
